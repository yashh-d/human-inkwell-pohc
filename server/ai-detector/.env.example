# Which model the worker loads. Never leaks to the client.
#   pangram    -> EditLens Llama-3.2-3B adapter (CC-BY-NC-SA, NON-COMMERCIAL: dev/research only)
#   binoculars -> BSD-3 / Falcon (commercial-clean) — production target (stub today)
DETECTOR_BACKEND=pangram

# Shared secret. If set, clients must send  Authorization: Bearer <token>.
# Must match DETECTOR_TOKEN in the Vercel env (used by /api/ai-detect).
DETECTOR_TOKEN=

# Hugging Face token — REQUIRED for the Pangram backend, because the base model
# meta-llama/Llama-3.2-3B is gated (accept Meta's license on HF first).
HF_TOKEN=

# Optional overrides
# PANGRAM_BASE_MODEL=meta-llama/Llama-3.2-3B
# PANGRAM_ADAPTER=pangram/editlens_Llama-3.2-3B
# PANGRAM_MAX_TOKENS=1024
